{
	"name": "resource-monitor",
	"displayName": "Resource Monitor",
	"description": "A simple resource monitor.",
	"version": "2.0.24",
	"publisher": "chneau",
	"license": "MIT",
	"galleryBanner": {
		"color": "#1E1E1E",
		"theme": "dark"
	},
	"keywords": [
		"performance",
		"resource",
		"resources",
		"monitor",
		"memory",
		"cpu",
		"io",
		"network",
		"disk",
		"storage"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/chneau/vscode-resource-monitor"
	},
	"icon": "images/icon.png",
	"engines": {
		"vscode": "^1.99.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/main.js",
	"scripts": {
		"sync:package": "bun ./scripts/syncPackageJson.ts",
		"screenshots": "bun ./scripts/screenshots.ts",
		"build": "bun run sync:package && esbuild ./src/main.ts --outfile=out/main.js --bundle --external:vscode --platform=node --minify",
		"watch": "bun run build --watch",
		"upgrade": "bun update --latest; bun install --dev @types/vscode@1.99.0",
		"check": "bun run --sequential --no-exit-on-error check:clean check:deno check:oxlint check:biome check:package check:export lint",
		"check:package": "bun ./scripts/syncPackageJson.ts --check",
		"lint": "tsc --noEmit",
		"bench": "hyperfine 'bun run benchmarks/multipleCalls.ts' 'bun run benchmarks/oneCall.ts'",
		"publish": "bun run build && vsce publish --no-dependencies; ovsx publish --no-dependencies",
		"all": "bun run --sequential --no-exit-on-error upgrade check",
		"check:deno": "deno fmt --use-tabs --quiet",
		"check:oxlint": "oxlint --fix-dangerously --fix-suggestions --fix --quiet",
		"check:biome": "timeout 3s biome check --write --unsafe --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true .",
		"clean": "rm -rf dist out build",
		"check:clean": "bun run clean",
		"check:export": "ts-unused-exports tsconfig.json --excludePathsFromReport=main.ts"
	},
	"dependencies": {
		"pretty-bytes": "^7.1.3",
		"systeminformation": "^5.33.8"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"@types/vscode": "1.99.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.2",
		"ovsx": "^1.1.1",
		"playwright-core": "^1.63.0",
		"typescript": "^7.0.2"
	},
	"contributes": {
		"commands": [
			{
				"command": "resource-monitor.openMenu",
				"title": "Resource Monitor: Configure Metrics"
			}
		],
		"configuration": {
			"title": "Resource Monitor",
			"properties": {
				"resource-monitor.cpu": {
					"type": "number",
					"default": 1,
					"description": "Order of the CPU usage. 0 to hide."
				},
				"resource-monitor.memory": {
					"type": "number",
					"default": 2,
					"description": "Order of the memory usage. 0 to hide."
				},
				"resource-monitor.network": {
					"type": "number",
					"default": 0,
					"description": "Order of the network usage. 0 to hide."
				},
				"resource-monitor.file-system": {
					"type": "number",
					"default": 0,
					"description": "Order of the file system usage. 0 to hide."
				},
				"resource-monitor.gpu": {
					"type": "number",
					"default": 0,
					"description": "Order of the GPU usage. 0 to hide."
				},
				"resource-monitor.battery": {
					"type": "number",
					"default": 0,
					"description": "Order of the battery level. 0 to hide."
				},
				"resource-monitor.temperature": {
					"type": "number",
					"default": 0,
					"description": "Order of the CPU temperature. 0 to hide."
				},
				"resource-monitor.refresh-interval": {
					"type": "number",
					"default": 3000,
					"description": "Refresh interval in milliseconds."
				}
			}
		}
	}
}
